<?xml version="1.0"?>
<package format="3">
  <name>ai_robot_task_manager</name>
  <version>0.1.0</version>
  <description>Non-AI ROS 2 task manager for validated robot capability execution.</description>
  <maintainer email="maintainer@example.com">AI Robot Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ai_robot_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
